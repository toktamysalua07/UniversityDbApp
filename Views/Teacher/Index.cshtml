@model IEnumerable<UniversityDbApp.Models.Teacher>
@{ViewData["Title"]="Teachers"; var page=(int)ViewBag.Page; var pages=(int)ViewBag.Pages;}
<div class="page-heading"><div><div class="eyebrow">THE PEOPLE BEHIND THE PROGRESS</div><h1>Teacher directory</h1><p>Meet the thinkers, mentors, and makers across campus.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Add teacher</a></div>
<form method="get" class="filter-bar"><div class="search-field"><i class="bi bi-search"></i><input name="q" value="@ViewBag.Query" placeholder="Search names, email, expertise…" /></div><select name="departmentId" asp-items="ViewBag.Departments" class="filter-select"><option value="">All departments</option></select><select name="position" class="filter-select"><option value="">All positions</option>@foreach(string p in (IEnumerable<string>)ViewBag.Positions){<option value="@p" selected="@(p==(string?)ViewBag.Position)">@p</option>}</select><select name="sort" class="filter-select"><option value="name">Sort: Name</option><option value="newest" selected="@((string)ViewBag.Sort=="newest")">Sort: Newest</option><option value="department" selected="@((string)ViewBag.Sort=="department")">Sort: Department</option></select><button class="btn btn-soft">Filter</button></form>
<section class="panel directory-panel"><div class="directory-head"><span>TEACHER</span><span>DEPARTMENT</span><span>ACADEMIC DEGREE</span><span>CONTACT</span><span></span></div>@foreach(var t in Model){<div class="directory-row"><a asp-action="Details" asp-route-id="@t.Id" class="directory-person"><span class="person-avatar">@t.FirstName[..1]@t.LastName[..1]</span><span class="person-main"><b>@t.FullName</b><small>@t.Position</small></span></a><a class="directory-dept" asp-controller="Department" asp-action="Details" asp-route-id="@t.DepartmentId"><span class="dept-code-small">@t.Department.Code</span>@t.Department.Name</a><span class="degree-cell">@(t.AcademicDegree ?? "—")</span><a class="email-cell" href="mailto:@t.Email"><i class="bi bi-envelope"></i> @t.Email</a><div class="row-actions"><a asp-action="Edit" asp-route-id="@t.Id" title="Edit"><i class="bi bi-pencil"></i></a><a asp-action="Delete" asp-route-id="@t.Id" class="danger-link" title="Delete"><i class="bi bi-trash3"></i></a></div></div>}
@if(!Model.Any()){<div class="empty-state"><i class="bi bi-people"></i><h3>No teachers found</h3><p>Adjust your filters or add a teacher profile.</p><a asp-action="Create" class="btn btn-primary">Add a teacher</a></div>}</section>
@if(pages>1){<nav class="pagination-row"><span>@("Page " + page + " of " + pages)</span><div>@if(page>1){<a class="btn btn-soft btn-sm" asp-route-page="@(page-1)" asp-route-q="@ViewBag.Query" asp-route-departmentId="@ViewBag.DepartmentId" asp-route-position="@ViewBag.Position" asp-route-sort="@ViewBag.Sort">Previous</a>}@if(page<pages){<a class="btn btn-soft btn-sm" asp-route-page="@(page+1)" asp-route-q="@ViewBag.Query" asp-route-departmentId="@ViewBag.DepartmentId" asp-route-position="@ViewBag.Position" asp-route-sort="@ViewBag.Sort">Next <i class="bi bi-arrow-right"></i></a>}</div></nav>}
