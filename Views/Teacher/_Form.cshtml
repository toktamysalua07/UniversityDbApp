@model UniversityDbApp.Models.Teacher
<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="FirstName"></label><input asp-for="FirstName" placeholder="First name"/><span asp-validation-for="FirstName"></span></div><div class="field"><label asp-for="LastName"></label><input asp-for="LastName" placeholder="Last name"/><span asp-validation-for="LastName"></span></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" placeholder="name@university.edu"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" placeholder="+7 700 000 00 00"/><span asp-validation-for="PhoneNumber"></span></div><div class="field"><label asp-for="Position"></label><input asp-for="Position" placeholder="Professor, Lecturer…"/><span asp-validation-for="Position"></span></div><div class="field"><label asp-for="DepartmentId"></label><select asp-for="DepartmentId" asp-items="ViewBag.Departments"><option value="">Select a department</option></select><span asp-validation-for="DepartmentId"></span></div><div class="field"><label asp-for="AcademicDegree"></label><select asp-for="AcademicDegree"><option value="">Select a degree</option><option>PhD</option><option>Doctor of Science</option><option>MSc</option><option>MA</option><option>BSc</option></select><span asp-validation-for="AcademicDegree"></span></div><div class="field"><label asp-for="Specialization"></label><input asp-for="Specialization" placeholder="Area of expertise"/><span asp-validation-for="Specialization"></span></div><div class="field"><label asp-for="HireDate"></label><input asp-for="HireDate" type="date"/><span asp-validation-for="HireDate"></span></div><div class="field"><label asp-for="EmploymentType"></label><select asp-for="EmploymentType"><option value="">Select type</option><option>Full-time</option><option>Part-time</option><option>Visiting</option></select><span asp-validation-for="EmploymentType"></span></div></div>
