@model UniversityDbApp.Models.Teacher
@{ViewData["Title"]="Teacher profile";}
<div class="page-heading"><div><div class="eyebrow">PEOPLE DIRECTORY / PROFILE</div><h1>Teacher profile</h1><p>A closer look at the people behind the work.</p></div><div class="heading-actions"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-soft"><i class="bi bi-pencil"></i> Edit profile</a><a asp-action="Index" class="btn btn-primary">Directory <i class="bi bi-arrow-right"></i></a></div></div>
<section class="panel teacher-profile"><div class="profile-left"><span class="profile-avatar">@Model.FirstName[..1]@Model.LastName[..1]</span><div class="eyebrow">@Model.Position</div><h2>@Model.FullName</h2><p>@Model.AcademicDegree · @Model.Department.Name</p><div class="profile-tags"><span><i class="bi bi-mortarboard"></i> @Model.AcademicDegree</span><span><i class="bi bi-building"></i> @Model.Department.Code</span></div></div><div class="profile-right"><h3>Profile details</h3><dl class="detail-list"><dt>Department</dt><dd><a asp-controller="Department" asp-action="Details" asp-route-id="@Model.DepartmentId">@Model.Department.Name</a></dd><dt>Position</dt><dd>@Model.Position</dd><dt>Specialization</dt><dd>@(Model.Specialization ?? "Not specified")</dd><dt>Hire date</dt><dd>@Model.HireDate.ToString("MMMM d, yyyy")</dd><dt>Employment type</dt><dd>@(Model.EmploymentType ?? "Not specified")</dd><dt>Email</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd><dt>Phone</dt><dd>@(Model.PhoneNumber ?? "Not specified")</dd></dl></div></section>
