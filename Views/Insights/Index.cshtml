@model UniversityDbApp.ViewModels.InsightsViewModel
@using System.Text.Json
@{ViewData["Title"]="Campus insights";}
<div class="page-heading"><div><div class="eyebrow">CAMPUS INSIGHTS</div><h1>See the whole picture.</h1><p>Real-time academic signals, shaped by your campus data.</p></div><button class="btn btn-soft" onclick="window.print()"><i class="bi bi-printer"></i> Print report</button></div>
<div class="stats-grid insights-stats"><article class="stat-card"><div class="stat-icon mint"><i class="bi bi-diagram-3"></i></div><div class="stat-number">@Model.DepartmentCount</div><div class="stat-label">Departments</div></article><article class="stat-card"><div class="stat-icon lilac"><i class="bi bi-people"></i></div><div class="stat-number">@Model.TeacherCount</div><div class="stat-label">Teaching staff</div></article><article class="stat-card"><div class="stat-icon peach"><i class="bi bi-building"></i></div><div class="stat-number">@Model.FacultyCount</div><div class="stat-label">Faculties</div></article><article class="stat-card"><div class="stat-icon blue"><i class="bi bi-hourglass-split"></i></div><div class="stat-number">@Model.AverageExperience.ToString("0.0") <small>yrs</small></div><div class="stat-label">Avg. experience</div></article></div>
<div class="content-grid insights-grid"><article class="panel chart-panel"><div class="panel-heading"><div><div class="eyebrow">CAMPUS DISTRIBUTION</div><h3>Teachers by department</h3></div></div><div class="chart-wrap chart-tall"><canvas id="departmentChart"></canvas></div></article><article class="panel chart-panel"><div class="panel-heading"><div><div class="eyebrow">QUALIFICATIONS</div><h3>Academic degrees</h3></div></div><div class="donut-wrap"><canvas id="degreeChart"></canvas><div class="donut-center"><b>@Model.TeacherCount</b><span>teachers</span></div></div><div class="legend-list" id="degreeLegend"></div></article><article class="panel chart-panel"><div class="panel-heading"><div><div class="eyebrow">AREAS OF EXPERTISE</div><h3>Teacher specializations</h3></div></div><div class="chart-wrap chart-tall"><canvas id="specialtyChart"></canvas></div></article><article class="panel chart-panel"><div class="panel-heading"><div><div class="eyebrow">HOW WE WORK</div><h3>Employment types</h3></div></div><div class="chart-wrap chart-tall"><canvas id="employmentChart"></canvas></div></article></div>
<div class="panel report-table"><div class="panel-heading"><div><div class="eyebrow">REFERENCE</div><h3>Department summary</h3></div><span class="muted-note">@DateTime.Today.ToString("MMMM d, yyyy")</span></div><div class="directory-head"><span>DEPARTMENT</span><span>FACULTY</span><span>TEACHERS</span><span>HEAD OF DEPARTMENT</span><span>LOCATION</span></div>@foreach(var d in Model.AllDepartments){<div class="directory-row report-row"><span class="directory-dept"><span class="dept-code-small">@d.Code</span>@d.Name</span><span class="degree-cell">@d.Faculty</span><b>@d.Teachers.Count</b><span>@(d.HeadOfDepartment ?? "—")</span><span>@(d.Location ?? "—")</span></div>}</div>
@section Scripts{<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script><script>window.campusData={labels:@Html.Raw(JsonSerializer.Serialize(Model.DepartmentLabels)),counts:@Html.Raw(JsonSerializer.Serialize(Model.TeacherCounts)),degrees:@Html.Raw(JsonSerializer.Serialize(Model.DegreeLabels)),degreeCounts:@Html.Raw(JsonSerializer.Serialize(Model.DegreeCounts)),specialties:@Html.Raw(JsonSerializer.Serialize(Model.SpecializationLabels)),specialtyCounts:@Html.Raw(JsonSerializer.Serialize(Model.SpecializationCounts)),employment:@Html.Raw(JsonSerializer.Serialize(Model.EmploymentLabels)),employmentCounts:@Html.Raw(JsonSerializer.Serialize(Model.EmploymentCounts))};</script><script src="~/js/charts.js" asp-append-version="true"></script>}
