@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var title = ViewData["Title"]?.ToString() ?? "Overview";
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title · CampusFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar" id="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span><span class="brand-copy"><strong>Campus<span>Flow</span></strong><small>ACADEMIC WORKSPACE</small></span></a>
        <div class="side-label">WORKSPACE</div>
        <nav class="side-nav">
            <a class="@(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Overview</span></a>
            <a class="@(controller == "Department" ? "active" : "")" asp-controller="Department" asp-action="Index"><i class="bi bi-diagram-3"></i><span>Departments</span><span class="nav-count">DB</span></a>
            <a class="@(controller == "Teacher" ? "active" : "")" asp-controller="Teacher" asp-action="Index"><i class="bi bi-people"></i><span>Teachers</span></a>
            <a class="@(controller == "Insights" ? "active" : "")" asp-controller="Insights" asp-action="Index"><i class="bi bi-bar-chart-line"></i><span>Campus insights</span></a>
            <a class="@(controller == "Structure" ? "active" : "")" asp-controller="Structure" asp-action="Index"><i class="bi bi-bezier2"></i><span>Academic structure</span></a>
        </nav>
        <div class="sidebar-bottom"><div class="side-label">CAMPUS STATUS</div><div class="status-card"><span class="status-pulse"></span><div><b>Workspace ready</b><small>University database</small></div></div><div class="sidebar-foot"><span class="mini-avatar">A</span><span><b>Alua</b><small>Administrator</small></span><i class="bi bi-three-dots"></i></div></div>
    </aside>
    <main class="main-area">
        <header class="topbar"><button class="icon-button mobile-menu" id="mobileMenu" aria-label="Open navigation"><i class="bi bi-list"></i></button><div class="crumb"><span>Workspace</span><i class="bi bi-chevron-right"></i><b>@title</b></div><div class="top-actions">
            <span class="today-label"><i class="bi bi-calendar3"></i> @DateTime.Today.ToString("ddd, MMM d")</span>
            <a class="icon-button search-trigger" asp-controller="Home" asp-action="Search" title="Search"><i class="bi bi-search"></i></a>
            <button class="icon-button" id="themeToggle" title="Switch theme" aria-label="Switch theme"><i class="bi bi-moon-stars"></i></button>
            <span class="top-avatar">A</span>
        </div></header>
        <div class="page-content">@if (TempData["Toast"] is string toast) { <div class="toast-message"><i class="bi bi-check-circle-fill"></i>@toast<button type="button" class="toast-close" onclick="this.parentElement.remove()">×</button></div> } @if (TempData["ToastError"] is string err) { <div class="toast-message toast-error"><i class="bi bi-exclamation-circle-fill"></i>@err<button type="button" class="toast-close" onclick="this.parentElement.remove()">×</button></div> } @RenderBody()</div>
        <footer class="page-footer"><span>© @DateTime.Today.Year UniversityDbApp</span><span>Designed for academic clarity <i class="bi bi-heart-fill"></i></span></footer>
    </main>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
