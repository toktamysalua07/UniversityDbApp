@model IEnumerable<UniversityDbApp.Models.Department>
@{ViewData["Title"]="Departments"; var page=(int)ViewBag.Page; var pages=(int)ViewBag.Pages;}
<div class="page-heading"><div><div class="eyebrow">YOUR ACADEMIC COMMUNITY</div><h1>Departments</h1><p>Explore the academic homes that make your campus.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New department</a></div>
<form method="get" class="filter-bar"><div class="search-field"><i class="bi bi-search"></i><input type="search" name="q" value="@ViewBag.Query" placeholder="Search departments…" /></div><select name="faculty" class="filter-select"><option value="">All faculties</option>@foreach(string f in (IEnumerable<string>)ViewBag.Faculties){<option selected="@(f==(string?)ViewBag.Faculty)" value="@f">@f</option>}</select><select name="sort" class="filter-select"><option value="name">Sort: A to Z</option><option value="faculty" selected="@((string)ViewBag.Sort=="faculty")">Sort: Faculty</option></select><button class="btn btn-soft">Apply filters</button></form>
<div class="accordion-list">@foreach(var d in Model){<details class="department-accordion"><summary><span class="dept-badge">@d.Code</span><span class="accordion-title"><b>@d.Name</b><small>@d.Faculty</small></span><span class="accordion-meta"><span><i class="bi bi-person-badge"></i> @(d.HeadOfDepartment ?? "Head not assigned")</span><span><i class="bi bi-geo-alt"></i> @(d.Location ?? "Location TBD")</span></span><span class="teacher-pill"><i class="bi bi-people"></i> @d.Teachers.Count</span><i class="bi bi-chevron-down accordion-chevron"></i></summary><div class="accordion-body"><p>@(d.Description ?? "No description has been added yet.")</p><div class="preview-teachers">@foreach(var t in d.Teachers.Take(4)){<a asp-controller="Teacher" asp-action="Details" asp-route-id="@t.Id" class="tiny-person"><span class="person-avatar">@t.FirstName[..1]@t.LastName[..1]</span><span><b>@t.FullName</b><small>@t.Position</small></span></a>}@if(!d.Teachers.Any()){<span class="muted-note">No teachers assigned yet.</span>}</div><div class="accordion-actions"><a asp-action="Details" asp-route-id="@d.Id" class="btn btn-soft btn-sm">View details</a><a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-quiet btn-sm"><i class="bi bi-pencil"></i> Edit</a><a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-quiet btn-sm danger-link"><i class="bi bi-trash3"></i> Delete</a></div></div></details>}</div>
@if(!Model.Any()){<div class="panel empty-state"><i class="bi bi-diagram-3"></i><h3>No departments match</h3><p>Try another filter, or create your first department.</p><a asp-action="Create" class="btn btn-primary">Create department</a></div>}
@if(pages>1){<nav class="pagination-row"><span>@("Page " + page + " of " + pages)</span><div>@if(page>1){<a class="btn btn-soft btn-sm" asp-route-page="@(page-1)" asp-route-q="@ViewBag.Query" asp-route-faculty="@ViewBag.Faculty" asp-route-sort="@ViewBag.Sort">Previous</a>}@if(page<pages){<a class="btn btn-soft btn-sm" asp-route-page="@(page+1)" asp-route-q="@ViewBag.Query" asp-route-faculty="@ViewBag.Faculty" asp-route-sort="@ViewBag.Sort">Next <i class="bi bi-arrow-right"></i></a>}</div></nav>}
