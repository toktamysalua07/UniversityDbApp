@model UniversityDbApp.Models.Department
@{ViewData["Title"]="Edit department";}
<div class="page-heading"><div><div class="eyebrow">ACADEMIC UNITS / EDIT</div><h1>Edit department</h1><p>Update the details for @Model.Name.</p></div><a asp-action="Index" class="btn btn-soft"><i class="bi bi-arrow-left"></i> Back to departments</a></div>
<form asp-action="Edit" method="post" class="panel form-panel"><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="CreatedAt"/><partial name="_Form" model="Model"/><div class="form-actions"><a asp-action="Index" class="btn btn-quiet">Cancel</a><button class="btn btn-primary"><i class="bi bi-check2"></i> Save changes</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
