@model UniversityDbApp.Models.Department
@{ViewData["Title"]="Delete department";}
<div class="page-heading"><div><div class="eyebrow">ACADEMIC UNITS / REMOVE</div><h1>Delete department?</h1><p>This action can’t be undone.</p></div></div><section class="panel confirm-panel"><span class="confirm-icon"><i class="bi bi-exclamation-triangle"></i></span><h2>@Model.Name</h2><p>@Model.Faculty · @Model.Code</p>@if(Model.Teachers.Count>0){<div class="alert-soft"><i class="bi bi-info-circle"></i> This department has @Model.Teachers.Count teacher(s). Reassign them before deleting.</div>}<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id"/><a asp-action="Index" class="btn btn-quiet">Keep department</a><button class="btn btn-danger" disabled="@(Model.Teachers.Count>0)">Delete department</button></form></section>
