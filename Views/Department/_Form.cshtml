@model UniversityDbApp.Models.Department
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-grid"><div class="field"><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. Computer Engineering" /><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Code"></label><input asp-for="Code" placeholder="e.g. CE" /><span asp-validation-for="Code"></span><small>A short unique identifier</small></div><div class="field"><label asp-for="Faculty"></label><input asp-for="Faculty" placeholder="e.g. Faculty of Engineering" /><span asp-validation-for="Faculty"></span></div><div class="field"><label asp-for="HeadOfDepartment"></label><input asp-for="HeadOfDepartment" placeholder="Full name" /><span asp-validation-for="HeadOfDepartment"></span></div><div class="field"><label asp-for="Location"></label><input asp-for="Location" placeholder="Building and floor" /><span asp-validation-for="Location"></span></div><div class="field"><label asp-for="EstablishedDate"></label><input asp-for="EstablishedDate" type="date" /><span asp-validation-for="EstablishedDate"></span></div><div class="field full"><label asp-for="Description"></label><textarea asp-for="Description" rows="4" placeholder="A few words about this department"></textarea><span asp-validation-for="Description"></span></div></div>
