@model UniversityDbApp.Models.Department
@{ViewData["Title"]="Department details";}
<div class="page-heading"><div><div class="eyebrow">ACADEMIC UNIT / @Model.Code</div><h1>@Model.Name</h1><p>@Model.Faculty</p></div><div class="heading-actions"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-soft"><i class="bi bi-pencil"></i> Edit</a><a asp-action="Index" class="btn btn-primary">All departments <i class="bi bi-arrow-right"></i></a></div></div>
<div class="detail-grid"><article class="panel detail-main"><div class="detail-code">@Model.Code</div><h2>@Model.Name</h2><p>@(Model.Description ?? "No department description has been added yet.")</p><div class="detail-stats"><div><b>@Model.Teachers.Count</b><small>Teachers</small></div><div><b>@(Model.EstablishedDate?.Year.ToString() ?? "—")</b><small>Established</small></div><div><b>@Model.Faculty</b><small>Faculty</small></div></div></article><article class="panel detail-side"><div class="eyebrow">AT A GLANCE</div><dl class="detail-list"><dt>Department head</dt><dd>@(Model.HeadOfDepartment ?? "Not assigned")</dd><dt>Location</dt><dd>@(Model.Location ?? "Not specified")</dd><dt>Department code</dt><dd>@Model.Code</dd></dl></article></div>
<article class="panel detail-people"><div class="panel-heading"><div><div class="eyebrow">THE PEOPLE</div><h3>Department directory</h3></div><a asp-controller="Teacher" asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Add teacher</a></div>@if(Model.Teachers.Any()){<div class="people-list">@foreach(var t in Model.Teachers.OrderBy(t=>t.LastName)){<a asp-controller="Teacher" asp-action="Details" asp-route-id="@t.Id" class="person-row person-link"><span class="person-avatar">@t.FirstName[..1]@t.LastName[..1]</span><span class="person-main"><b>@t.FullName</b><small>@t.Position · @t.Email</small></span><span class="person-degree">@t.AcademicDegree</span><i class="bi bi-arrow-up-right row-arrow"></i></a>}</div>}else{<div class="empty-inline">No teachers here yet. Add the first profile to this department.</div>}</article>
