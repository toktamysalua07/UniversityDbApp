@model UniversityDbApp.ViewModels.DashboardViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Overview"; }
<section class="welcome-line"><div><div class="eyebrow"><span class="eyebrow-dot"></span> MONDAY MOMENTUM</div><h1>Good morning, Alua <span class="wave">✳</span></h1><p>Your university, thoughtfully organized.</p></div><a asp-controller="Insights" asp-action="Index" class="btn btn-soft"><i class="bi bi-arrow-up-right"></i> Explore insights</a></section>
<section class="hero-card"><div class="hero-copy"><div class="hero-kicker"><i class="bi bi-stars"></i> YOUR CAMPUS, IN FOCUS</div><h2>Every connection<br />moves learning forward.</h2><p>A clear view of the people, departments, and ideas shaping your academic community.</p><div class="hero-actions"><a asp-controller="Department" asp-action="Index" class="btn btn-white">Explore departments <i class="bi bi-arrow-right"></i></a><span class="hero-note"><i class="bi bi-shield-check"></i> Your data, in one place</span></div></div><div class="hero-art"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="art-dot dot-one"></div><div class="art-dot dot-two"></div><div class="art-center"><i class="bi bi-mortarboard-fill"></i></div><div class="art-chip chip-a"><i class="bi bi-people-fill"></i> @Model.TeacherCount people</div><div class="art-chip chip-b"><i class="bi bi-diagram-3-fill"></i> @Model.DepartmentCount departments</div><div class="art-spark">✦</div></div></section>
<section class="stats-grid">
    <article class="stat-card stat-feature"><div class="stat-top"><span class="stat-icon mint"><i class="bi bi-diagram-3"></i></span><span class="stat-trend"><i class="bi bi-arrow-up-right"></i> Live</span></div><div class="stat-number">@Model.DepartmentCount.ToString("00")</div><div class="stat-label">Departments</div><div class="stat-foot">Across your academic community</div></article>
    <article class="stat-card"><div class="stat-top"><span class="stat-icon lilac"><i class="bi bi-people"></i></span><span class="stat-mini">PEOPLE</span></div><div class="stat-number">@Model.TeacherCount.ToString("00")</div><div class="stat-label">Teaching staff</div><div class="stat-foot">Profiles in the directory</div></article>
    <article class="stat-card"><div class="stat-top"><span class="stat-icon peach"><i class="bi bi-building"></i></span><span class="stat-mini">FACULTIES</span></div><div class="stat-number">@Model.FacultyCount.ToString("00")</div><div class="stat-label">Faculties</div><div class="stat-foot">Connected by shared purpose</div></article>
    <article class="stat-card"><div class="stat-top"><span class="stat-icon blue"><i class="bi bi-clock-history"></i></span><span class="stat-mini">EXPERIENCE</span></div><div class="stat-number">@Model.AverageExperience.ToString("0.0")<small> yrs</small></div><div class="stat-label">Average experience</div><div class="stat-foot">Years in higher education</div></article>
</section>
<section class="content-grid dashboard-lower"><article class="panel chart-panel"><div class="panel-heading"><div><div class="eyebrow">PEOPLE & PLACES</div><h3>Teachers by department</h3></div><a asp-controller="Insights" asp-action="Index" class="text-link">Full report <i class="bi bi-arrow-up-right"></i></a></div><div class="chart-wrap"><canvas id="departmentChart" aria-label="Teachers per department"></canvas></div></article>
<article class="panel degree-panel"><div class="panel-heading"><div><div class="eyebrow">ACADEMIC MIX</div><h3>Degree distribution</h3></div><span class="panel-menu"><i class="bi bi-three-dots"></i></span></div><div class="donut-wrap"><canvas id="degreeChart"></canvas><div class="donut-center"><b>@Model.TeacherCount</b><span>teachers</span></div></div><div class="legend-list" id="degreeLegend"></div></article></section>
<section class="content-grid bottom-grid"><article class="panel department-panel"><div class="panel-heading"><div><div class="eyebrow">ACADEMIC UNITS</div><h3>Departments at a glance</h3></div><a asp-controller="Department" asp-action="Index" class="text-link">View all <i class="bi bi-arrow-right"></i></a></div><div class="department-list">@foreach(var d in Model.Departments){<a asp-controller="Department" asp-action="Details" asp-route-id="@d.Id" class="department-row"><span class="dept-badge">@d.Code</span><span class="dept-main"><b>@d.Name</b><small>@d.Faculty</small></span><span class="dept-people"><i class="bi bi-people"></i> @d.Teachers.Count</span><i class="bi bi-arrow-up-right row-arrow"></i></a>}</div></article>
<article class="panel recent-panel"><div class="panel-heading"><div><div class="eyebrow">COMMUNITY</div><h3>Recently added</h3></div><a asp-controller="Teacher" asp-action="Index" class="text-link">Directory <i class="bi bi-arrow-right"></i></a></div><div class="people-list">@foreach(var t in Model.RecentTeachers){<div class="person-row"><span class="person-avatar">@t.FirstName[..1]@t.LastName[..1]</span><span class="person-main"><b>@t.FullName</b><small>@t.Position · @t.Department.Name</small></span><span class="person-degree">@t.AcademicDegree</span></div>}@if(Model.RecentTeachers.Count==0){<div class="empty-inline">Your directory is ready for its first teacher.</div>}</div></article></section>
@section Scripts {<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script><script>window.campusData={labels:@Html.Raw(JsonSerializer.Serialize(Model.DepartmentLabels)),counts:@Html.Raw(JsonSerializer.Serialize(Model.TeacherCounts)),degrees:@Html.Raw(JsonSerializer.Serialize(Model.DegreeLabels)),degreeCounts:@Html.Raw(JsonSerializer.Serialize(Model.DegreeCounts))};</script><script src="~/js/charts.js" asp-append-version="true"></script>}
