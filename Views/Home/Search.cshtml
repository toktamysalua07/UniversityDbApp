@model UniversityDbApp.ViewModels.SearchViewModel
@{ViewData["Title"]="Search campus";}
<div class="page-heading"><div><div class="eyebrow">CAMPUS SEARCH</div><h1>Find your place.</h1><p>Search people, departments, faculties, and areas of expertise.</p></div></div><form method="get" class="global-search"><i class="bi bi-search"></i><input autofocus name="q" value="@Model.Query" placeholder="Try a name, faculty, or specialization…"/><button class="btn btn-primary">Search</button></form>
@if(Model.Query.Length>0){<div class="search-results"><section class="panel"><div class="panel-heading"><div><div class="eyebrow">ACADEMIC UNITS</div><h3>Departments <small>@Model.Departments.Count</small></h3></div></div>@foreach(var d in Model.Departments){<a asp-controller="Department" asp-action="Details" asp-route-id="@d.Id" class="search-result"><span class="dept-badge">@d.Code</span><span><b>@d.Name</b><small>@d.Faculty</small></span><i class="bi bi-arrow-up-right"></i></a>}@if(!Model.Departments.Any()){<p class="empty-inline">No departments found.</p>}</section><section class="panel"><div class="panel-heading"><div><div class="eyebrow">PEOPLE</div><h3>Teachers <small>@Model.Teachers.Count</small></h3></div></div>@foreach(var t in Model.Teachers){<a asp-controller="Teacher" asp-action="Details" asp-route-id="@t.Id" class="search-result"><span class="person-avatar">@t.FirstName[..1]@t.LastName[..1]</span><span><b>@t.FullName</b><small>@t.Position · @t.Department.Name · @t.Specialization</small></span><i class="bi bi-arrow-up-right"></i></a>}@if(!Model.Teachers.Any()){<p class="empty-inline">No teachers found.</p>}</section></div>}
