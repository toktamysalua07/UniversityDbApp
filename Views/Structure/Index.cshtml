@model IEnumerable<UniversityDbApp.Models.Department>
@{ViewData["Title"]="Academic structure"; var groups=Model.GroupBy(d=>d.Faculty).OrderBy(g=>g.Key);}
<div class="page-heading"><div><div class="eyebrow">THE CAMPUS, CONNECTED</div><h1>Academic structure</h1><p>Follow the relationships between faculties, departments, and people.</p></div><button class="btn btn-soft" onclick="window.print()"><i class="bi bi-printer"></i> Print view</button></div>
<section class="structure-intro"><span class="structure-icon"><i class="bi bi-mortarboard-fill"></i></span><div><small>UNIVERSITY</small><h2>UniversityDbApp</h2><p>@groups.Count() faculties <span>·</span> @Model.Count() departments <span>·</span> @Model.Sum(d=>d.Teachers.Count) teachers</p></div></section>
<div class="tree-list">@foreach(var faculty in groups){<details class="faculty-node" open><summary><span class="tree-branch"><i class="bi bi-building"></i></span><span><b>@faculty.Key</b><small>@faculty.Count() departments · @faculty.Sum(d=>d.Teachers.Count) teachers</small></span><i class="bi bi-chevron-down tree-chevron"></i></summary><div class="faculty-children">@foreach(var d in faculty){<details class="department-node"><summary><span class="tree-leaf">@d.Code</span><span><b>@d.Name</b><small>@d.Teachers.Count teachers · @(d.Location ?? "Location not set")</small></span><a class="tree-view" asp-controller="Department" asp-action="Details" asp-route-id="@d.Id" onclick="event.stopPropagation()">Open <i class="bi bi-arrow-up-right"></i></a><i class="bi bi-chevron-down tree-chevron"></i></summary><div class="teacher-branches">@foreach(var t in d.Teachers.OrderBy(t=>t.LastName)){<a asp-controller="Teacher" asp-action="Details" asp-route-id="@t.Id" class="teacher-branch"><span class="person-avatar">@t.FirstName[..1]@t.LastName[..1]</span><span><b>@t.FullName</b><small>@t.Position · @t.AcademicDegree</small></span><i class="bi bi-arrow-up-right"></i></a>}@if(!d.Teachers.Any()){<span class="muted-note">No teacher profiles in this department yet.</span>}</div></details>}</div></details>}</div>
